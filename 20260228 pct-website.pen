            }
          ]
        },
        {
          "type": "frame",
          "id": "vWBP2",
          "name": "PP Body",
          "width": "fill_container",
          "fill": "$bg-white",
          "layout": "vertical",
          "gap": 40,
          "padding": [
            0,
            320,
            80,
            320
          ],
          "children": [
            {
              "type": "frame",
              "id": "TGcby",
              "name": "ppSec1",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "WHnSc",
                  "fill": "$text-primary",
                  "content": "1. Information We Collect",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "1ALtB",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We collect information in the following ways:\n\n• Donations: When you make a donation, we collect your first name, last name, email address, and an optional message. Payment card details are processed directly by Stripe and are never stored on our servers.\n\n• Pledges: When you make a pledge-per-mile commitment, we collect your email address, display name (optional), pledge amount, and pledge interval. Your email is hashed for secure storage and used to look up your pledge status.\n\n• IP Geolocation: When you submit a pledge, we automatically collect your approximate geographic location (city and country) via your IP address. This is used to display pledger locations on an aggregate map. We also use IP-based geolocation on the trail map to show your approximate distance from Paul.\n\n• GPS Tracker Data: Paul's real-time location is collected via his phone's GPS and displayed publicly on the trail map.\n\n• Analytics: We collect anonymous, aggregate analytics data including page views, browser type, and device information. This data does not personally identify you.\n\n• Cookies & Local Storage: We use essential cookies for site functionality. We also store your approximate location in your browser's localStorage to power the distance tracker feature. This data never leaves your device unless you submit a pledge.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "GAWsR",
              "name": "ppSec2",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "8HiWk",
                  "fill": "$text-primary",
                  "content": "2. How We Use Your Information",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "4zmch",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Your information is used to:\n\n• Process and acknowledge donations via Stripe\n• Display donor names and messages on the public Donor Wall (unless you opt for anonymity)\n• Track and display your pledge-per-mile commitment\n• Display pledger names on the public Pledger Wall (unless you opt for anonymity)\n• Show aggregate pledger locations on the trail map\n• Send transactional emails: pledge confirmations, challenge notifications, and challenge results\n• Calculate and display your distance from Paul on the trail\n• Improve website functionality and content through anonymous analytics\n\nWe never sell, rent, or trade your personal information to third parties for marketing purposes.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "SCq1s",
              "name": "ppSec3",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "ICyAg",
                  "fill": "$text-primary",
                  "content": "3. Data Storage & Retention",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "fhrt1",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Your data is stored securely using the following services:\n\n• Upstash Redis (cloud database): Stores donation records, pledge records, pledger locations, and GPS tracking data. Hosted on encrypted infrastructure.\n• Stripe: Processes and stores payment information under PCI DSS compliance. We do not store card numbers, CVVs, or other payment credentials.\n• Vercel: Hosts the website. Server logs are retained per Vercel's standard policy.\n\nRetention periods:\n• Donation records: Retained indefinitely for fundraising transparency\n• Pledge records: Retained for the duration of the PCT hike and 12 months after completion\n• GPS location history: Automatically deleted after 90 days\n• Email addresses: Retained until you request deletion\n• Browser localStorage data: Stored on your device until you clear it",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "MHtfs",
              "name": "ppSec4",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "AdTOD",
                  "fill": "$text-primary",
                  "content": "4. Email Communications",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "w8eOu",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We send transactional emails only — never marketing spam. You may receive:\n\n• Pledge confirmation when you register a pledge\n• Challenge notifications when Paul starts a trail challenge\n• Challenge results when a challenge ends (including any boost applied to your pledge)\n\nEmails are sent via Resend, a third-party email delivery service. You can opt out of challenge notifications by contacting us at paul@yeschapter.com. Pledge confirmation emails cannot be opted out of as they serve as your receipt.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "jzZsO",
              "name": "ppSec5",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "AarqA",
                  "fill": "$text-primary",
                  "content": "5. Third-Party Services",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "rAxGi",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "This website integrates with the following third-party services, each with their own privacy policies:\n\n• Stripe — Payment processing (PCI DSS Level 1 compliant)\n• Upstash — Cloud database (encrypted at rest and in transit)\n• Vercel — Website hosting and serverless functions\n• OpenStreetMap / OpenTopoMap — Trail map tiles\n• Resend — Transactional email delivery\n• ip-api.com — IP-based geolocation (city/country only)\n• YouTube — Embedded video content and caption extraction\n• Anthropic (Claude AI) — Blog post generation from video transcripts (no user data is sent to this service)\n\nWe encourage you to review the privacy policies of these services.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Hk0Qu",
              "name": "ppSec6",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "sWpUt",
                  "fill": "$text-primary",
                  "content": "6. Your Rights",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Vn8qW",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You have the right to:\n\n• Request access to the personal data we hold about you\n• Request correction or deletion of your personal data\n• Request that your donation or pledge be displayed as \"Anonymous\"\n• Opt out of challenge notification emails\n• Request deletion of your pledge record entirely\n• Clear your browser's localStorage to remove locally stored location data\n\nTo exercise any of these rights, contact us at paul@yeschapter.com. We will respond to data requests within 30 days.\n\nNote: Pledge lookups are available via email address without a password. If you are concerned about unauthorized access to your pledge information, contact us to discuss additional security measures.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wcmx3",
              "name": "ppSec7",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "ZGhrF",
                  "fill": "$text-primary",
                  "content": "7. Data Security",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "JK3sd",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We implement reasonable security measures to protect your personal information:\n\n• All data transmission is encrypted via HTTPS/TLS\n• Payment data is handled exclusively by Stripe (PCI DSS compliant)\n• Email addresses are stored as SHA-256 hashes for pledge lookups\n• GPS tracker updates require authentication via a secret token\n• The admin panel is protected by a separate authentication token\n\nHowever, no method of internet transmission is 100% secure. We cannot guarantee absolute security of your data.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "E2NoD",
              "name": "ppSec8",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "npe23",
                  "fill": "$text-primary",
                  "content": "8. Children's Privacy",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "EAsQv",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "This website is not directed at children under 13. We do not knowingly collect personal information from children. If you believe a child has provided us with personal data, please contact us at paul@yeschapter.com and we will promptly delete the information.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "5g9pS",
              "name": "ppSec9",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "jd1f8",
                  "fill": "$text-primary",
                  "content": "9. Changes to This Policy",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "e4IEk",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated \"Last updated\" date. Continued use of the website after changes constitutes acceptance of the revised policy.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Y6bGI",
              "name": "ppSec10",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "PqMFu",
                  "fill": "$text-primary",
                  "content": "10. Contact Us",
                  "fontFamily": "Source Serif 4",
                  "fontSize": 24,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "HFaQ9",
                  "fill": "$text-secondary",
