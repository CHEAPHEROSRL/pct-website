                  "children": [
                    {
                      "type": "text",
                      "id": "V5VMV",
                      "name": "f1AboutTitle",
                      "fill": "$text-primary",
                      "content": "About",
                      "fontFamily": "Source Serif 4",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "wRcld",
                      "name": "f1AboutText",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Founded in 1996, Tower Cancer Research Foundation is a 501(c)(3) non-profit based in Beverly Hills, California. They have conducted over 400 clinical trials for the development of new and more effective cancer treatments. Their work spans research, patient support, and community education — creating outsized impact in Southern California and nationally.",
                      "lineHeight": 1.7,
                      "fontFamily": "Source Serif 4",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "QsuU2",
                      "name": "f1ProgramsTitle",
                      "fill": "$text-primary",
                      "content": "Key Programs",
                      "fontFamily": "Source Serif 4",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "isk0z",
                      "name": "f1Programs",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Clinical Research — Over 400 clinical trials developing new cancer treatments\n• Magnolia House — Free survivorship program with 130+ monthly classes, workshops, and holistic services for patients and families\n• Community Grants — Funding for childhood/young adult cancer organizations and support for underserved communities",
                      "lineHeight": 1.7,
                      "fontFamily": "Source Serif 4",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
