                      "name": "bioQuoteAttr",
                      "fill": "$burnt-orange",
                      "content": "— Paul Barry",
                      "fontFamily": "Barlow Semi Condensed",
                      "fontSize": 12,
                      "fontWeight": "600",
                      "letterSpacing": 1
                    }
                  ]
                }
              ]
            }
