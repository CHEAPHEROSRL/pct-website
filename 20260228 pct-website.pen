            {
              "type": "frame",
              "id": "CIUKw",
              "name": "bioText",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "children": [
                {
                  "type": "text",
                  "id": "Has3H",
                  "name": "bioLabel",
                  "fill": "$burnt-orange",
                  "content": "ABOUT PAUL",
                  "fontFamily": "Barlow Semi Condensed",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 3
                },
                {
                  "type": "text",
                  "id": "ggXk1",
                  "name": "bioTitle",
                  "fill": "$text-primary",
                  "content": "The Man Behind the Walk",
                  "lineHeight": 1.2,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 36,
                  "fontWeight": "600",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "TrDxs",
                  "name": "bioP1",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Paul Barry lost both of his parents to cancer. His father passed in 2018, his mother in 2022. In their honor — and for every family walking the same painful road — Paul is thru-hiking the Pacific Crest Trail in 2026.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "tJiAm",
                  "name": "bioP2",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The PCT runs 2,650 miles from the Mexican border to Manning Park in British Columbia, Canada, through some of the most remote and beautiful terrain in North America. Paul will walk it all — desert, mountains, and rain forests — in approximately 180 days.",
                  "lineHeight": 1.8,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "Ht3UO",
                  "name": "bioQuote",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "padding": [
                    4,
                    0,
                    4,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "a35Gn",
                      "name": "bioQuoteText",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "&quot;Every mile I walk is a mile closer to a world where fewer families have to say goodbye too soon.&quot;",
                      "lineHeight": 1.6,
                      "fontFamily": "Source Serif 4",
                      "fontSize": 16,
                      "fontWeight": "600",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
