              "children": [
                {
                  "type": "text",
                  "id": "isUF7",
                  "name": "builtBadge",
                  "fill": "#3D7A5A",
                  "content": "ALREADY BUILT (GAPS 1–5)",
                  "fontFamily": "Barlow Semi Condensed",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 3
                },
                {
                  "type": "text",
                  "id": "I5Qlw",
                  "name": "builtList",
                  "fill": "#FFFFFFAA",
                  "content": "✅ Inline pledge increase flow + confirmation email\n✅ Pre-milestone nudge emails (within 50mi)\n✅ \"Increase Pledge\" + \"Share\" CTAs in ALL emails\n✅ Near-finish 3-email sequence (200mi / 100mi / finish)\n✅ Honor page + post-finish drip (day 5 + day 14)\n✅ Admin honor tracking tab\n✅ Weekly updates every Monday\n✅ Milestone reached notifications (11 milestones)\n✅ Challenge start/result emails\n✅ 76–92 emails per pledger over full hike",
                  "lineHeight": 1.7,
                  "fontFamily": "Source Serif 4",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "jjyhD",
              "name": "newCard",
              "width": "fill_container",
              "fill": "#C45C2622",
              "cornerRadius": 8,
              "layout": "vertical",
              "gap": 8,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "T7WrH",
                  "name": "newBadge",
                  "fill": "#C45C26",
                  "content": "GAPS IDENTIFIED (V2)",
                  "fontFamily": "Barlow Semi Condensed",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 3
                },
                {
                  "type": "text",
                  "id": "Ngtqz",
                  "name": "newList",
                  "fill": "#FFFFFFAA",
                  "content": "⚠️ Gap 6 — No unsubscribe / email preferences\n⚠️ Gap 7 — No welcome drip after pledge\n⚠️ Gap 8 — No community milestone emails\n⚠️ Gap 9 — No honor confirmation email\n⚠️ Gap 10 — No referral landing page\n\nRisk: 76+ emails with no opt-out = spam complaints\nRisk: Days of silence between pledge and first Monday\nMissed: Community FOMO (\"50 pledgers!\") not triggered\nMissed: Pledger honors but gets no thank-you email\nMissed: \"Share\" links go to homepage, not referral page",
                  "lineHeight": 1.7,
                  "fontFamily": "Source Serif 4",
