                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What Does 2,650 Miles Actually Look Like? The Science of a Thru-Hike",
                      "lineHeight": 1.3,
                      "fontFamily": "Source Serif 4",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
